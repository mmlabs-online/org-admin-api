APP_ENV=local
APP_DEBUG=true
APP_VERSION=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/org_admin
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/org_admin_test
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
# JSON list, required in staging/production (private CIDRs only), e.g. ["172.18.0.0/16"]
TRUSTED_PROXY_CIDRS=
SIGNUP_RATE_LIMIT=
SIGNUP_RATE_WINDOW_SECONDS=
ROLE_CATALOG_RATE_LIMIT=
ROLE_CATALOG_RATE_WINDOW_SECONDS=
LOGIN_RATE_LIMIT=
LOGIN_RATE_WINDOW_SECONDS=
# Per-IP limit for POST /api/v1/auth/token (default 60 per 60 s)
TOKEN_RATE_LIMIT=
TOKEN_RATE_WINDOW_SECONDS=
# Per-IP limit for GET /.well-known/jwks.json (default 120 per 60 s)
JWKS_RATE_LIMIT=
JWKS_RATE_WINDOW_SECONDS=
# Secret: base64 of a PEM P-256 private key on one line (ADR-0005); required in staging/production
JWT_SIGNING_KEY=
# JSON list of base64 public PEMs also published in the JWKS (rotation only; not secret)
JWT_PUBLIC_KEYS_EXTRA=
# Token `iss`; required in staging/production as https://<host> (production: https://api.mmlabs.online)
JWT_ISSUER=
# Access-token lifetime in seconds (default 900, 60-3600)
ACCESS_TOKEN_TTL_SECONDS=
# Secret, >= 32 random chars; required in staging/production (login failure counters)
IDENTITY_HMAC_KEY=
DEVICE_SESSION_IDLE_DAYS=
DEVICE_SESSION_MAX_DAYS=
# Email (USR-04, docs/deploy.md "Email"): Gmail SMTP with STARTTLS (defaults smtp.gmail.com:587)
SMTP_HOST=
SMTP_PORT=
# Required in staging/production: the Gmail address and its App Password (secret)
SMTP_USERNAME=
SMTP_PASSWORD=
# From address (default SMTP_USERNAME)
EMAIL_FROM=
# Global verification/reset sends per 24 h (default 300; the Gmail account is shared).
# Verification uses at most 80 %, password reset the rest.
EMAIL_DAILY_CAP=
# Per-IP limit for POST /api/v1/auth/verify-email (default 20 per 60 s)
VERIFY_EMAIL_RATE_LIMIT=
VERIFY_EMAIL_RATE_WINDOW_SECONDS=
# Per-IP limit for POST /api/v1/auth/verify-email/resend (default 5 per 600 s)
VERIFY_EMAIL_RESEND_RATE_LIMIT=
VERIFY_EMAIL_RESEND_RATE_WINDOW_SECONDS=
# Per-IP limit for POST /api/v1/auth/password/forgot (default 5 per 60 s)
FORGOT_RATE_LIMIT=
FORGOT_RATE_WINDOW_SECONDS=
# Per-IP limit for POST /api/v1/auth/password/reset (default 10 per 60 s)
RESET_RATE_LIMIT=
RESET_RATE_WINDOW_SECONDS=
PASSWORD_MIN_LENGTH=
ARGON2_TIME_COST=
ARGON2_MEMORY_KIB=
ARGON2_PARALLELISM=
ARGON2_MAX_CONCURRENCY=
ADMIN_USERS_API_ENABLED=
ADMIN_RBAC_API_ENABLED=
