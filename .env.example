# Default local. Must be set explicitly (local|test|staging|production) when DATABASE_URL
# is not a plain loopback DSN (no query string).
APP_ENV=
# Default false.
APP_DEBUG=
APP_VERSION=
# Default postgresql+asyncpg://postgres:postgres@localhost:5432/org_admin
DATABASE_URL=
# Tests only (tests/conftest.py); default postgresql+asyncpg://postgres:postgres@localhost:5432/org_admin_test
TEST_DATABASE_URL=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
# JSON list, required in staging/production (private CIDRs only), e.g. ["172.18.0.0/16"]
TRUSTED_PROXY_CIDRS=
SIGNUP_RATE_LIMIT=
SIGNUP_RATE_WINDOW_SECONDS=
ROLE_CATALOG_RATE_LIMIT=
ROLE_CATALOG_RATE_WINDOW_SECONDS=
LOGIN_RATE_LIMIT=
LOGIN_RATE_WINDOW_SECONDS=
# Per-IP limit for POST /api/v1/auth/token (default 60 per 60 s)
TOKEN_RATE_LIMIT=
TOKEN_RATE_WINDOW_SECONDS=
# Per-IP limit for GET /api/v1/auth/accounts (default 60 per 60 s)
ACCOUNTS_RATE_LIMIT=
ACCOUNTS_RATE_WINDOW_SECONDS=
# Per-IP limit for POST /api/v1/auth/apps/{key}/join (default 20 per 60 s)
JOIN_RATE_LIMIT=
JOIN_RATE_WINDOW_SECONDS=
# Org creation per IP (default 10 per 3600 s), org list per IP (60 per 60 s), orgs a user may
# create in total (20)
ORG_CREATE_RATE_LIMIT=
ORG_CREATE_RATE_WINDOW_SECONDS=
ORGS_LIST_RATE_LIMIT=
ORGS_LIST_RATE_WINDOW_SECONDS=
ORG_CREATE_MAX_PER_USER=
INVITATION_CREATE_RATE_LIMIT=
INVITATION_CREATE_RATE_WINDOW_SECONDS=
INVITATION_ACCEPT_RATE_LIMIT=
INVITATION_ACCEPT_RATE_WINDOW_SECONDS=
INVITATION_TTL_HOURS=
INVITATION_MAX_PER_INVITER_PER_DAY=
INVITATION_MAX_PENDING_PER_ORG=
# Per-IP limit for GET /.well-known/jwks.json (default 120 per 60 s)
JWKS_RATE_LIMIT=
JWKS_RATE_WINDOW_SECONDS=
# Per-IP limit for PUT /api/v1/apps/{key}/manifest (default 30 per 60 s)
APP_MANIFEST_RATE_LIMIT=
APP_MANIFEST_RATE_WINDOW_SECONDS=
# Secret: base64 of a PEM P-256 private key on one line (ADR-0005); required in staging/production
JWT_SIGNING_KEY=
# JSON list of base64 public PEMs also published in the JWKS (rotation only; not secret)
JWT_PUBLIC_KEYS_EXTRA=
# Token `iss`; required in staging/production as https://<host> (production: https://api.mmlabs.online)
JWT_ISSUER=
# Access-token lifetime in seconds (default 900, 60-43200; production 43200, ADR-0005 §6)
ACCESS_TOKEN_TTL_SECONDS=
# Secret, >= 32 random chars; required in staging/production (login failure counters)
IDENTITY_HMAC_KEY=
DEVICE_SESSION_IDLE_DAYS=
DEVICE_SESSION_MAX_DAYS=
# Email (USR-04, docs/deploy.md "Email"): Gmail SMTP with STARTTLS (defaults smtp.gmail.com:587)
SMTP_HOST=
SMTP_PORT=
# Required in staging/production: the Gmail address and its App Password (secret)
SMTP_USERNAME=
SMTP_PASSWORD=
# From address (default SMTP_USERNAME)
EMAIL_FROM=
# Global verification/reset/invitation sends per 24 h (default 300; the Gmail account is
# shared). Verification uses at most 70 %, password reset 40 %, invitations 10 %.
EMAIL_DAILY_CAP=
# Per-IP limit for POST /api/v1/auth/verify-email (default 20 per 60 s)
VERIFY_EMAIL_RATE_LIMIT=
VERIFY_EMAIL_RATE_WINDOW_SECONDS=
# Per-IP limit for POST /api/v1/auth/verify-email/resend (default 5 per 600 s)
VERIFY_EMAIL_RESEND_RATE_LIMIT=
VERIFY_EMAIL_RESEND_RATE_WINDOW_SECONDS=
# Per-IP limit for POST /api/v1/auth/password/forgot (default 5 per 60 s)
FORGOT_RATE_LIMIT=
FORGOT_RATE_WINDOW_SECONDS=
# Per-IP limit for POST /api/v1/auth/password/reset (default 10 per 60 s)
RESET_RATE_LIMIT=
RESET_RATE_WINDOW_SECONDS=
PASSWORD_MIN_LENGTH=
ARGON2_TIME_COST=
ARGON2_MEMORY_KIB=
ARGON2_PARALLELISM=
ARGON2_MAX_CONCURRENCY=
# Swagger UI and /openapi.json; unset = off in production, on elsewhere (true/false)
API_DOCS_ENABLED=
